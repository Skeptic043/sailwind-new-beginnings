<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
    <EquipmentSource Condition="'$(EquipmentSource)' == ''">../../src/AdditionalEquipment.cs</EquipmentSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" Exclude="*.template.cs" />
    <Compile Include="generated/Handoff.cs" />
    <Compile Include="$(EquipmentSource)" />
    <Compile Include="../../src/ModEquipment.cs" />
    <Compile Include="../../src/StartingOptions.cs" />
  </ItemGroup>
</Project>
