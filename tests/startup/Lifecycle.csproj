<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0649;CS0414</NoWarn>
    <ProductionPlacementPath Condition="'$(ProductionPlacementPath)' == ''">../../src/FixedStart.Placement.cs</ProductionPlacementPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Doubles.cs" />
    <Compile Include="NativeYards.generated.cs" />
    <Compile Include="Checks.cs" />
    <Compile Include="$(ProductionPlacementPath)" />
    <Compile Include="../../src/ScrambledSeasIntegration.cs" />
    <Compile Include="../../src/StarterOwnership.cs" />
    <Compile Include="../../src/ShipyardStart.cs" />
    <Compile Include="../../src/KnownSites.cs" />
  </ItemGroup>
</Project>
